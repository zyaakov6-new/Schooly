rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)) &&
        request.auth.uid in
          get(/databases/$(database)/documents/families/$(familyId)).data.members
            .map(m, m.userId);
    }

    // Users: can only read/write own doc
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Families: members can read/write
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn();
      allow update: if isFamilyMember(familyId);
      allow delete: if false; // Admin only via Cloud Functions

      // Children subcollection
      match /children/{childId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // Events subcollection
      match /events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) &&
                         request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId);
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) &&
                         request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId);
      }

      // Inbox subcollection
      match /inbox/{messageId} {
        allow read, write: if isFamilyMember(familyId);
      }
    }
  }
}
